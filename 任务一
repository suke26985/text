#include<Servo.h>
Servo base,fArm,rArm,claw;//base是底座 fArm是前臂左边舵机 rArm是后臂右边舵机 claw是夹爪舵机
int basePos=90,fArmPos=90,rArmPos=90,clawPos=90;
const int baseMin=0,baseMax=180,rArmMin=0,rArmMax=180,fArmMin=30,fArmMax=125,clawMin=20,clawMax=120;
int DSD=10; //默认电机速度Default Servo Delay
int fromPos,toPos;
void setup() {
base.attach(9);
delay(200);
fArm.attach(8);
delay(200);
rArm.attach(7);
delay(200);
claw.attach(6);
delay(200);
Serial.begin(9600);
Serial.println("Please input Serial value");
}

void loop() {
  if(Serial.available()>0){
    char SerialCmd=Serial.read();
    armDataCmd(SerialCmd);   
    }
}


void armDataCmd(char serialCmd){
  if(serialCmd=='b'||serialCmd=='f'||serialCmd=='r'||serialCmd=='c'){
    int servoData=Serial.parseInt();
    servoCmd(serialCmd,servoData,DSD);
    }
  else{
      switch(serialCmd){
        case'u':
          reportStatus();
          break;
        case'O':
          servoCmd('c',20,DSD);
        break;
        case'S':
          servoCmd('c',120,DSD);
        break;
        case'H':
          DSD=5;
          break;
        case'L':
          DSD=15;
          break;
        case'B':
          DSD=10;
          servoCmd('b',90,DSD);
          servoCmd('b',90,DSD);
          servoCmd('b',90,DSD);
          servoCmd('b',90,DSD);
        }
    }   
}



void servoCmd(char servoName,int toPos,int servoDelay){
  Servo servo2go; 
    switch(servoName){
      case'b':
      if(toPos>=baseMin&&toPos<=baseMax){
        servo2go=base;
        fromPos=base.read();
        break;
        }
      else{
        Serial.println("Warning:Base Servo Value Out Of Limit!");
        return;
        }
      case'f':
      if(toPos>=fArmMin&&toPos<=fArmMax){
        servo2go=base;
        fromPos=fArm.read();
        break;
        }
      else{
        Serial.println("Warning:fArm Servo Value Out Of Limit!");
        return;
        }
        case'r':
        if(toPos>=rArmMin&&toPos<=rArmMax){
        servo2go=rArm;
        fromPos=rArm.read();
        break;
        }
      else{
        Serial.println("Warning:rArm Servo Value Out Of Limit!");
        return;
        }
        case'c':
      if(toPos>=clawMin&&toPos<=clawMax){
        servo2go=claw;
        fromPos=claw.read();
        break;
        }
      else{
        Serial.println("Warning:Claw Servo Value Out Of Limit!");
        return;
        } 
    }  
    if(fromPos<=toPos){
        for(int i=fromPos;i<=toPos;i++){
        servo2go.write(i);
        delay(servoDelay);
        }
    }
    else{
        for(int i=fromPos;i>=toPos;i--){
        servo2go.write(i);
        delay(servoDelay);
        } 
    }       
}
void reportStatus(){
  Serial.println("");
  Serial.println("+ Robot-Arm Status Report +");
  Serial.print("Base Position: "); Serial.println(base.read());
  Serial.print("Front Arm Position:"); Serial.println(fArm.read());
  Serial.print("Rear  Arm Position:"); Serial.println(rArm.read());
  Serial.print("Claw Position: "); Serial.println(claw.read());
  Serial.println("++++++++++++++++++++++++++");
  Serial.println("");
  }
