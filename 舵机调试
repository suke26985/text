const int baseMin,baseMax,rArmMin,rArmMax,fArmMin,fArmMax,clawMin,clawMax;
void setup() {
  // put your setup code here, to run once:
base.attach(11);
fArm.attach(10);
rArm.attach(9);
claw.attach(6);
Serial.begin(9600);
Serial.println("Please input Serial value");
}

void loop() {
  // put your main code here, to run repeatedly:
  if(Serial.available()>0){
    char SerialCmd=Serial.read();
    armDateCmd(SerialCmd);
    base.write(basePos);
    delay(10);
    fArm.write(fArmpos);
     delay(10);
    rArm.write(rArmpos);
     delay(10);
    claw.write(clawpos);
     delay(10);
    }
}
void armDataCmd(char SerialCmd){
Serial.print("SerialCmd=");
